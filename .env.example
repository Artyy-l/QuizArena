# Локальные настройки Docker Compose.
# Скопируйте файл в .env и укажите API-ключ.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://polza.ai/api/v1
OPENAI_MODEL=openai/gpt-6-luna-pro
ETHICS_MODEL=openai/gpt-6-luna-pro
MAX_PARALLEL_LLM_CALLS=3
WORKER_COUNT=2
REQUEST_TIMEOUT_SECONDS=180
ENABLE_REASONING=false
REASONING_EFFORT=medium
FORCE_JSON_RESPONSE=true
